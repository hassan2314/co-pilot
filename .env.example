# gemini (default) | openai | local
# local answers from retrieved text with no API key. Re-index after changing provider.
LLM_PROVIDER=gemini

GEMINI_API_KEY=your_gemini_api_key
GOOGLE_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# Reachable Postgres with pgvector. Not localhost on FastAPI Cloud.
DATABASE_URL=postgresql://acme:acme@localhost:5432/docs
DB_CONNECT_TIMEOUT=5

# Comma-separated extra browser origins. Or CORS_ALLOW_ALL=true for the API widget.
CORS_ORIGINS=
CORS_ALLOW_ALL=false

MAX_DOCUMENTS=50
MAX_UPLOAD_BYTES=8388608
